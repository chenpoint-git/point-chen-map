<!DOCTYPE html>
<html lang="zh-TW">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Point Chen 商品全台寄售店地圖</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <link rel="stylesheet" href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css" />
    <script src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js"></script>
    <style>
        @import url('https://fonts.googleapis.com/css2?family=Noto+Sans+TC:wght@400;700&display=swap');
        
        :root {
            --vintage-green: #4c755d;
            --beige: #fdfaf5;
            --dark-brown: #3d2b1f;
        }

        body {
            font-family: 'Noto Sans TC', sans-serif;
            background-color: var(--vintage-green);
            color: var(--beige);
        }

        #map { 
            height: 500px; 
            width: 100%; 
            border-radius: 2rem; 
            z-index: 1;
        }

        @media (min-width: 768px) {
            #map { height: 650px; }
        }

        /* 自訂 Leaflet 彈出視窗樣式 */
        .custom-popup .leaflet-popup-content-wrapper {
            border-radius: 1.2rem;
            padding: 0.5rem;
            box-shadow: 0 10px 25px -5px rgba(0, 0, 0, 0.3);
            background-color: var(--beige);
            border: 2px solid #d4c3a1;
        }
        .custom-popup .leaflet-popup-tip {
            background: var(--beige);
        }

        /* 自訂捲軸 */
        #store-list::-webkit-scrollbar {
            width: 5px;
        }
        #store-list::-webkit-scrollbar-track {
            background: rgba(255, 255, 255, 0.1);
        }
        #store-list::-webkit-scrollbar-thumb {
            background: rgba(255, 255, 255, 0.3);
            border-radius: 10px;
        }

        /* 標記動畫 */
        .marker-pin {
            transition: all 0.3s cubic-bezier(0.175, 0.885, 0.32, 1.275);
        }
        .marker-pin:hover {
            transform: scale(1.3) translateY(-2px);
        }
    </style>
</head>
<body class="p-4 md:p-8">

    <div class="max-w-6xl mx-auto">
        <!-- 標題區 -->
        <header class="mb-12 text-center relative">
            <div class="inline-block relative">
                <h1 class="text-4xl md:text-5xl font-bold text-white mb-2 relative z-10 tracking-wider">
                    Point Chen <span class="text-[#d4c3a1]">Stockists</span>
                </h1>
                <div class="absolute -bottom-2 left-0 w-full h-3 bg-[#3d5a47] opacity-60 -rotate-1 z-0"></div>
            </div>
            <p class="mt-4 text-stone-200/70 font-light tracking-[0.2em] flex items-center justify-center text-sm">
                由 北 至 南 寄 售 店 家 地 圖
            </p>
        </header>

        <div class="grid grid-cols-1 lg:grid-cols-12 gap-10">
            
            <!-- 店家列表 -->
            <div class="lg:col-span-4 space-y-4">
                <div class="bg-[#fcf8f0] rounded-[2.5rem] p-6 shadow-2xl border border-white/20 flex flex-col h-full max-h-[700px]">
                    <div class="flex items-center justify-between mb-6">
                        <h2 class="text-xl font-bold text-[#4c755d] flex items-center">
                            <span class="bg-[#4c755d] text-white p-2 rounded-xl mr-3 shadow-md">
                                <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" viewBox="0 0 20 20" fill="currentColor">
                                    <path d="M10.707 2.293a1 1 0 00-1.414 0l-7 7a1 1 0 001.414 1.414L4 10.414V17a1 1 0 001 1h2a1 1 0 001-1v-2a1 1 0 011-1h2a1 1 0 011 1v2a1 1 0 001 1h2a1 1 0 001-1v-6.586l.293.293a1 1 0 001.414-1.414l-7-7z" />
                                </svg>
                            </span>
                            門市清單
                        </h2>
                        <span class="bg-stone-200/50 px-3 py-1 rounded-full text-[10px] font-bold text-stone-500 uppercase tracking-tighter">8 Locations</span>
                    </div>
                    
                    <div class="overflow-y-auto pr-2 space-y-3" id="store-list">
                        <!-- 店家卡片會由 JS 注入 -->
                    </div>
                </div>
            </div>

            <!-- 地圖區 -->
            <div class="lg:col-span-8">
                <div class="relative">
                    <div class="absolute -top-10 -right-10 w-32 h-32 bg-white/5 rounded-full blur-3xl"></div>
                    <div id="map" class="shadow-2xl border-[6px] border-white/10 ring-1 ring-white/5"></div>
                </div>
                
                <div class="mt-8 flex flex-wrap gap-4 justify-center">
                    <div class="bg-white/10 backdrop-blur-md px-6 py-3 rounded-2xl border border-white/10 text-stone-200 text-xs flex items-center tracking-wide">
                        <span class="w-2 h-2 bg-[#d4c3a1] rounded-full mr-3 animate-pulse"></span>
                        依地理位置由北向南排序
                    </div>
                </div>
            </div>

        </div>

        <footer class="mt-16 mb-8 text-center">
            <div class="h-px w-24 bg-white/20 mx-auto mb-6"></div>
            <p class="text-white/40 text-xs tracking-[0.3em] font-light italic">
                © POINT CHEN - A LITTLE BIT OF HAPPINESS
            </p>
        </footer>
    </div>

    <script>
        const stores = [
            { id: 3, city: "台北", name: "田園城市生活風格書店", address: "台北市中山區中山北路二段72巷6號", lat: 25.0575, lng: 121.5225, mapUrl: "https://maps.app.goo.gl/yQitN9y5E79W6mUq6", color: "#a67b5b" },
            { id: 8, city: "台北", name: "飛地書店", address: "台北市萬華區中華路一段170-2號", lat: 25.0425, lng: 121.5075, mapUrl: "https://maps.app.goo.gl/nowhere", color: "#96694c" },
            { id: 1, city: "台北", name: "茉莉生活風格", address: "台北市中正區臨沂街27巷9-4號", lat: 25.0416, lng: 121.5303, mapUrl: "https://maps.app.goo.gl/9fFpvGfJds954GVP8", color: "#8a9a5b" },
            { id: 9, city: "台北", name: "Mangasick", address: "台北市中正區羅斯福路三段244巷10弄2號B1", lat: 25.0165, lng: 121.5315, mapUrl: "https://maps.app.goo.gl/mangasick", color: "#708090" },
            { id: 6, city: "桃園", name: "蒔絮行", address: "桃園市中壢區忠孝路246巷29弄41號", lat: 24.9745, lng: 121.2512, mapUrl: "https://maps.app.goo.gl/e7W3uR8K8H2P6zX7", color: "#556b2f" },
            { id: 7, city: "台南", name: "白丁書店", address: "台南市白河區三間厝40之13號", lat: 23.3445, lng: 120.4158, mapUrl: "https://maps.app.goo.gl/S9R2uD7K5V4X9wZ6", color: "#bc8f8f" },
            { id: 2, city: "高雄", name: "三餘書店", address: "高雄市新興區中正二路214號", lat: 22.6310, lng: 120.3155, mapUrl: "https://maps.app.goo.gl/35C1vXqC3C7V9T5e6", color: "#c19a6b" },
            { id: 4, city: "高雄", name: "駁二舊事倉庫", address: "高雄市鹽埕區大義街2號 (C8-1倉庫)", lat: 22.6191, lng: 120.2835, mapUrl: "https://maps.app.goo.gl/LzK8U4M6Z9J7P6wX9", color: "#6b8e23" }
        ];

        // 初始化地圖，中心點設在台灣中心
        const map = L.map('map', {
            zoomControl: false,
            scrollWheelZoom: false // 避免捲動頁面時意外縮放地圖
        }).setView([23.7, 121], 7);

        L.tileLayer('https://{s}.basemaps.cartocdn.com/rastertiles/voyager_labels_under/{z}/{x}/{y}{r}.png', {
            attribution: '© CartoDB'
        }).addTo(map);
        
        L.control.zoom({ position: 'bottomright' }).addTo(map);

        const markers = [];
        const storeListContainer = document.getElementById('store-list');

        stores.forEach((store, index) => {
            const customIcon = L.divIcon({
                html: `<div class="marker-pin" style="background-color: ${store.color}; width: 22px; height: 22px; border-radius: 50%; border: 3px solid #fdfaf5; box-shadow: 0 4px 8px rgba(0,0,0,0.3);"></div>`,
                className: '',
                iconSize: [22, 22],
                iconAnchor: [11, 11]
            });

            const marker = L.marker([store.lat, store.lng], { icon: customIcon }).addTo(map);
            
            const popupContent = `
                <div class="p-3 text-center">
                    <div class="inline-block px-2 py-0.5 rounded-full text-[10px] font-bold text-white mb-2 shadow-sm" style="background-color: ${store.color}">${store.city}</div>
                    <div class="text-lg font-bold text-[#3d2b1f] mb-1">${store.name}</div>
                    <div class="text-[11px] text-stone-500 mb-4 leading-relaxed">${store.address}</div>
                    <a href="${store.mapUrl}" target="_blank" class="block w-full py-2.5 px-4 bg-[#4c755d] text-white rounded-xl text-sm font-bold hover:bg-[#3d5a47] transition-all shadow-md">
                        前往 Google Map ➔
                    </a>
                </div>
            `;
            
            marker.bindPopup(popupContent, { 
                className: 'custom-popup',
                maxWidth: 220
            });
            markers.push(marker);

            // 列表卡片
            const card = document.createElement('div');
            card.className = 'group p-5 rounded-[1.8rem] bg-white hover:bg-[#fcf8f0] border border-stone-100 hover:border-[#d4c3a1] cursor-pointer transition-all duration-500 hover:shadow-xl hover:shadow-[#4c755d]/10';
            
            card.innerHTML = `
                <div class="flex items-center gap-5">
                    <div class="w-11 h-11 rounded-full flex items-center justify-center text-sm font-bold shrink-0 border border-stone-100 group-hover:scale-110 transition-transform duration-500" style="background-color: ${store.color}; color: white; box-shadow: 0 4px 10px ${store.color}30">
                        ${index + 1}
                    </div>
                    <div class="min-w-0">
                        <div class="flex items-center gap-2 mb-0.5">
                            <span class="text-[9px] font-bold uppercase tracking-widest text-[#4c755d] opacity-60">${store.city}</span>
                        </div>
                        <div class="font-bold text-[#3d2b1f] text-base truncate group-hover:text-[#4c755d] transition-colors">${store.name}</div>
                        <div class="text-[11px] text-stone-400 truncate mt-1">${store.address}</div>
                    </div>
                </div>
            `;
            
            card.onclick = () => {
                map.setView([store.lat, store.lng], 16);
                marker.openPopup();
                if (window.innerWidth < 1024) {
                    const mapElement = document.getElementById('map');
                    window.scrollTo({ top: mapElement.offsetTop - 80, behavior: 'smooth' });
                }
            };
            
            storeListContainer.appendChild(card);
        });

        // 重要：初始化時根據所有點位調整地圖邊界，確保完整顯示台灣分佈
        const group = new L.featureGroup(markers);
        map.fitBounds(group.getBounds().pad(0.15)); // 加入 15% 的邊距讓視覺不擁擠

    </script>
</body>
</html>
